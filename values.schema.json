            },
            "Story_ProcesVerbal": {
              "$ref": "#/definitions/mapResources"
            },
            "DLC_Story_LostHarvest_EcolabA": {
              "$ref": "#/definitions/mapResources"
            },
            "DLC_Story_LostHarvest_EcolabB": {
              "$ref": "#/definitions/mapResources"
            },
            "DLC_Story_LostHarvest_ForgottenLab": {
              "$ref": "#/definitions/mapResources"
            },
            "Story_ArtOfKanly": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Dungeon_Hephaestus": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Dungeon_OldCarthag": {
              "$ref": "#/definitions/mapResources"
            },
            "Story_Faction_Outpost_Atre": {
              "$ref": "#/definitions/mapResources"
            },
            "Story_Faction_Outpost_Hark": {
              "$ref": "#/definitions/mapResources"
            },
            "Story_HeighlinerDungeon": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Ecolab_Bronze_Green_089": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Ecolab_Bronze_Green_152": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Ecolab_Bronze_Green_024": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Ecolab_Bronze_Green_195": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Ecolab_Bronze_Green_136": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Overland_M_01": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Overland_S_04": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Overland_S_06": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Story_BanditFortress01": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Overland_S_07": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Overland_S_08": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Dungeon_ThePit": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Story_DestroyedZanovar": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Story_OrbitalMonitor": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Arrakis_Story_Paranoid_PrayerRoom": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Arrakis_Story_Glutton_DiningRoom": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Arrakis_Generic_Sietch_Room": {
              "$ref": "#/definitions/mapResources"
            }
          }
        },
        "taxation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "cycleLengthSeconds",
            "paymentItemPerHour",
            "spicePerHour",
            "costMultiplierPerLandclaim",
            "costMultiplierPerVerticalExtension"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "cycleLengthSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "paymentItemPerHour": {
              "type": "number",
              "minimum": 0
            },
            "spicePerHour": {
              "type": "number",
              "minimum": 0
            },
            "costMultiplierPerLandclaim": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "costMultiplierPerVerticalExtension": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": [
        "class",
        "databaseSize",
        "sharedSize"
      ],
      "properties": {
        "class": {
          "type": "string"
        },
        "databaseSize": {
          "type": "string",
          "minLength": 1
        },
        "sharedSize": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "nodeCIDRs",
        "playerCIDRs",
        "apiServerCIDRs",
        "game",
        "monitoring"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "nodeCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
          }
        },
        "playerCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
          },
          "minItems": 1
        },
        "apiServerCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
          },
          "minItems": 1
        },
        "game": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port",
            "endPort"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "endPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "namespaceSelector",
            "podSelector",
            "ports"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "matchExpressions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "key",
                      "operator"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "operator": {
                        "enum": [
                          "In",
                          "NotIn",
                          "Exists",
                          "DoesNotExist"
                        ]
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "matchLabels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "matchExpressions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "key",
                      "operator"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "operator": {
                        "enum": [
                          "In",
                          "NotIn",
                          "Exists",
                          "DoesNotExist"
                        ]
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "ports": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "port"
                ],
                "properties": {
                  "protocol": {
                    "enum": [
                      "TCP",
                      "UDP",
                      "SCTP"
                    ]
                  },
                  "port": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 15,
                        "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "nodeCIDRs": {
            "minItems": 1
          }
        }
      }
    },
    "backups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "schedule",
        "existingSecret",
        "bucket",
        "storage",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+(\\s+\\S+){4}$",
          "description": "Five-field cron schedule, interpreted by the operator in UTC."
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "bucket": {
          "type": "string",
          "minLength": 3,
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "size"
          ],
          "properties": {
            "class": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
