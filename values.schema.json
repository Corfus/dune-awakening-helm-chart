{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "operators",
        "game",
        "postgres",
        "yq",
        "python",
        "pghero",
        "filebrowser"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "operators": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "game": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "revision"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "yq": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
            "version"
          ],
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
            "version"
          ],
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "pghero": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
            "version"
          ],
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "filebrowser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
            "version"
          ],
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "credentials": {
      "type": "object",
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "world": {
      "type": "object",
      "required": [
        "title",
        "stop",
        "pvpMode",
        "gameplay",
        "mapResources",
        "taxation"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "stop": {
          "type": "boolean"
        },
        "battlEyeEnabled": {
          "description": "Override BattlEye anti-cheat; null preserves the game image default.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "pvpMode": {
          "description": "NoPVP for PvE, Limited for normal PvP zones, FullPVP for PvP everywhere.",
          "type": "string",
          "enum": [
            "NoPVP",
            "Limited",
            "FullPVP"
          ]
        },
        "serverLoginPassword": {
          "type": "string",
          "maxLength": 0
        },
        "gameplay": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gatheringMultiplier": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "GatheringAmount"
            },
            "xpMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "GlobalXpMultiplier"
            },
            "combatXpMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "CombatXp"
            },
            "gatheringXpMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "GatheringXp"
            },
            "missionXpMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "MissionXp"
            },
            "craftingTimeMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 5,
              "description": "CraftingTimeMultiplier"
            },
            "craftingCostMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "CraftingCost"
            },
            "buildingCostMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "BuildingCostMultiplier"
            },
            "inventoryVolumeMultiplier": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "InventoryVolumeMultiplier"
            },
            "lootRespawnSpeed": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "LootRespawnSpeed"
            },
            "resourceRespawnSpeed": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "ResourceRespawnSpeed"
            },
            "equipmentDropOnDeath": {
              "type": "string",
              "enum": [
                "All",
                "Backpack",
                "Default",
                "None"
              ],
              "description": "DropEquipmentOnDeath"
            },
            "sandwormDeathPenalty": {
              "type": "string",
              "enum": [
                "All",
                "Backpack",
                "Default",
                "None"
              ],
              "description": "SandwormConsequences"
            },
            "playerDeathLootRule": {
              "type": "string",
              "enum": [
                "DependsOnSecurityZone",
                "NeverAllowOtherPlayers",
                "AlwaysAllowOtherPlayers"
              ],
              "description": "PlayerDeathLootRule"
            },
            "itemDurabilityDrainMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "ItemDurabilityDrainMultiplier"
            },
            "maxDurabilityLossEnabled": {
              "type": "boolean",
              "description": "bEnableItemMaxDurabilityLoss"
            },
            "vehicleDurabilityDamageMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "dw.VehicleDurabilityDamageMultiplier"
            },
            "sandwormsEnabled": {
              "type": "boolean",
              "description": "bAllowSandworms"
            },
            "sandstormsEnabled": {
              "type": "boolean",
              "description": "bAllowSandstorms"
            },
            "coriolisStormsEnabled": {
              "type": "boolean",
              "description": "m_bCoriolisAutoSpawnEnabled"
            },
            "buildingPieceLimitMultiplier": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "BuildingPieceLimitMultiplier"
            },
            "maxBases": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 10,
              "description": "FiefdomLimit"
            },
            "infiniteBuildingStability": {
              "type": "boolean",
              "description": "bBuildingInfiniteStability"
            },
            "dynamicBuildingDamageEnabled": {
              "type": "boolean",
              "description": "bAllowDynamicBuildingDamage"
            },
            "thirstMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "ThirstMultiplier"
            },
            "heatBuildupMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "HeatBuildupRate"
            },
            "waterExtractionRate": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "WaterExtractionRate: Water extraction time; higher takes longer"
            },
            "fuelBurnTimeMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "FuelBurnTimeMultiplier: Fuel burn multiplier; zero removes fuel burn"
            },
            "playerDamageToPlayer": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "PlayerDamageToPlayer: Player damage to players"
            },
            "playerDamageToNPC": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "PlayerDamageToNPC: Player damage to NPCs"
            },
            "playerDamageToVehicle": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "PlayerDamageToVehicle: Player damage to vehicles"
            },
            "npcHealth": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "NPCHealth: NPC health"
            },
            "npcDamageToPlayer": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "NPCDamageToPlayer: NPC damage to players"
            },
            "npcDamageToNPC": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "NPCDamageToNPC: NPC damage to NPCs"
            },
            "npcRespawnMultiplier": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "NPCRespawnMultiplier: NPC respawn speed; higher respawns sooner"
            },
            "pvpDamageStructures": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "PVPDamageStructures: Player damage to unshielded bases; zero disables it"
            },
            "playerStaminaDrain": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "PlayerStaminaDrain: Stamina drain; higher drains faster"
            },
            "intelPointsGainMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "IntelPointsGainMultiplier: Intel Point gain; zero disables it"
            },
            "playerShieldDamageAbsorptionMultiplier": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "PlayerShieldDamageAbsorptionMultiplier: Player shield absorption; higher lasts longer"
            },
            "npcShieldDamageAbsorptionMultiplier": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "NPCShieldDamageAbsorptionMultiplier: NPC shield absorption; higher lasts longer"
            },
            "landsraadContributionMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "LandsraadContributionMultiplier: Landsraad contribution gain"
            },
            "landsraadSpecializationXpMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "LandsraadSpecializationXpMultiplier: Landsraad specialization XP gain"
            },
            "landsraadFactionStandingMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "LandsraadFactionStandingMultiplier: Landsraad faction standing changes"
            },
            "buildingRestrictionsEnabled": {
              "type": "boolean",
              "description": "bIsBuildingRestrictionsEnabled: enforce no-build zones"
            }
          },
          "required": [
            "gatheringMultiplier",
            "xpMultiplier",
            "combatXpMultiplier",
            "gatheringXpMultiplier",
            "missionXpMultiplier",
            "craftingTimeMultiplier",
            "craftingCostMultiplier",
            "buildingCostMultiplier",
            "inventoryVolumeMultiplier",
            "lootRespawnSpeed",
            "resourceRespawnSpeed",
            "equipmentDropOnDeath",
            "sandwormDeathPenalty",
            "playerDeathLootRule",
            "itemDurabilityDrainMultiplier",
            "maxDurabilityLossEnabled",
            "vehicleDurabilityDamageMultiplier",
            "sandwormsEnabled",
            "sandstormsEnabled",
            "coriolisStormsEnabled",
            "buildingPieceLimitMultiplier",
            "infiniteBuildingStability",
            "dynamicBuildingDamageEnabled",
            "thirstMultiplier",
            "heatBuildupMultiplier",
            "waterExtractionRate",
            "fuelBurnTimeMultiplier",
            "playerDamageToPlayer",
            "playerDamageToNPC",
            "playerDamageToVehicle",
            "npcHealth",
            "npcDamageToPlayer",
            "npcDamageToNPC",
            "npcRespawnMultiplier",
            "pvpDamageStructures",
            "playerStaminaDrain",
            "intelPointsGainMultiplier",
            "playerShieldDamageAbsorptionMultiplier",
            "npcShieldDamageAbsorptionMultiplier",
            "landsraadContributionMultiplier",
            "landsraadSpecializationXpMultiplier",
            "landsraadFactionStandingMultiplier",
            "buildingRestrictionsEnabled"
          ]
        },
        "mapResources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Survival_1": {
              "$ref": "#/definitions/mapResources"
            },
            "Overmap": {
              "$ref": "#/definitions/mapResources"
            },
            "SH_Arrakeen": {
              "$ref": "#/definitions/mapResources"
            },
            "SH_HarkoVillage": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Story_Hephaestus": {
              "$ref": "#/definitions/mapResources"
            },
            "CB_Story_Ecolab_Carthag": {
              "$ref": "#/definitions/mapResources"
